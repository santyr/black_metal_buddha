# Private staging uses a separate Unix service account and PostgreSQL role/database.
APP_ENV=staging
PUBLIC_BASE_URL=http://127.0.0.1:8091
DATABASE_URL=postgresql+psycopg:///blackmetalbuddha_staging?host=/var/run/postgresql
SUPPORT_EMAIL=

PHASE1_API_ENABLED=false
PRODUCTION_CHECKOUT_ENABLED=false
PHASE0_5_APPROVED=false
PRODUCTION_CATALOG_APPROVED=false
PRODUCTION_CATALOG_FINGERPRINT=
PRODUCTION_CANARY_APPROVED=false
PRODUCTION_CANARY_MODE=false

PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_NOTIFICATION_URL=
PAYPAL_PRODUCTION_CANARY_APPROVED=false
CHECKOUT_TAX_MODE=disabled
CHECKOUT_TAX_POLICY_APPROVED=false

PRINTFUL_MODE=disabled
PRINTFUL_CONFIRM_ENABLED=false
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_PUBLIC_KEY=
PRINTFUL_WEBHOOK_SECRET_KEY=

EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

APP_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_REFUNDS_ENABLED=false
ADMIN_CANCEL_FULFILLMENT_ENABLED=false
