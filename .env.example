# Black Metal Buddha configuration.
# Safe defaults intentionally keep public transactions disabled.
APP_ENV=production
PUBLIC_BASE_URL=https://blackmetalbuddha.com
SUPPORT_EMAIL=
DATABASE_URL=postgresql+psycopg://blackmetalbuddha:CHANGE_ME@127.0.0.1/blackmetalbuddha

# Public transactional storefront/API. Keep false until every production gate passes.
PHASE1_API_ENABLED=false
PRODUCTION_CHECKOUT_ENABLED=false
PRODUCTION_CANARY_APPROVED=false
PRODUCTION_CANARY_MODE=false
PRODUCTION_CATALOG_APPROVED=false
PRODUCTION_CATALOG_FINGERPRINT=

# Physical product gate.
PHASE0_5_APPROVED=false

# Square.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-09-16
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://blackmetalbuddha.com/api/v1/webhooks/square

# PayPal foundation. These settings do not activate PayPal checkout yet.
# Sandbox and production require separate app credentials and webhook IDs.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Planned route; webhook handler is delivered in migration Task 3.
PAYPAL_WEBHOOK_NOTIFICATION_URL=https://blackmetalbuddha.com/api/phase1/webhooks/paypal

# Owner-approved policy: live Printful quoted tax/VAT charged separately.
# Set these only after configuring the approved live quote path.
CHECKOUT_TAX_MODE=disabled
CHECKOUT_TAX_POLICY_APPROVED=false
# Separate from any historical Square canary approval.
PAYPAL_PRODUCTION_CANARY_APPROVED=false

# Printful.
# disabled = no calls; draft = create/reconcile drafts; production = chargeable confirmation allowed.
PRINTFUL_MODE=disabled
PRINTFUL_CONFIRM_ENABLED=false
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_PUBLIC_KEY=
PRINTFUL_WEBHOOK_SECRET_KEY=

# Transactional email.
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Owner console. Configure all three together to expose /admin.
APP_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Destructive/financial admin actions have separate kill switches.
ADMIN_REFUNDS_ENABLED=false
ADMIN_CANCEL_FULFILLMENT_ENABLED=false
OWNER_CONSOLE_ENABLED=false

# Printful is the source for product names, variants, prices and mockup images.
PRINTFUL_CATALOG_SYNC_ENABLED=false
# Set an absolute persistent directory writable by the sync service in production.
PRINTFUL_CATALOG_IMAGE_DIR=
